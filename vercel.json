{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.google.com https://maps.googleapis.com 'sha256-5fkgTZ6GqADqP+z57wCtar6DhMcttWvDu6XiYA7eQ0E=' 'sha256-5q9FhTWCNjDTj5ZjXeHCF3rRs09vFTCZBkwtYWgJnns=' 'sha256-717UnUGB4TDv1E2nvasX8Lvq036wogEh7Ui/3eNLRLg=' 'sha256-QQOXIvfgbgREf3c2WI+Aahx8oR2Tt5qcuGCZ9ur2KJQ=' 'sha256-TOP6IMUMCEw5Xa7kj/8VJV/lBDTWcAlY7zUimvtyLd4=' 'sha256-XaPb/EXu165ZmuthJ3hoz1e+uaSdyQPANHRj+aoNrug='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/assets/built/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/built/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/assets/(img|logo)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "qveewellness.com"
        }
      ],
      "destination": "https://www.qveewellness.com/:path*",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/about.html",
      "permanent": true
    },
    {
      "source": "/practices",
      "destination": "/practices.html",
      "permanent": true
    },
    {
      "source": "/membership",
      "destination": "/membership.html",
      "permanent": true
    },
    {
      "source": "/visit",
      "destination": "/visit.html",
      "permanent": true
    }
  ]
}
