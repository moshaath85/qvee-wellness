# ---------------------------------------------------------------
# QVee Wellness — Apache configuration
# Place this file as .htaccess in the web root.
# Requires: mod_headers, mod_expires, mod_deflate, mod_rewrite, mod_mime
# ---------------------------------------------------------------

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com https://maps.googleapis.com 'sha256-3sS9tE2Rf5Zqi6q1OpQV8misE8UQKMLv8d6mXCszqIw=' 'sha256-4w7U9XNxK4/Im8ErKcIxh1ebv747+R1megzdXjOQfQc=' 'sha256-6Q/GDIzRkKbd2n3Mw9uvBVVWV6avXOH8LlqBS9B1f9Q=' 'sha256-9PdmtWr9dj5z63LbK6s9byMlkoIiDfWAc4e9n1KCGgg=' 'sha256-QQOXIvfgbgREf3c2WI+Aahx8oR2Tt5qcuGCZ9ur2KJQ=' 'sha256-kEx7RMGKOvwGqR7hPLr4+CvZYtpVs5Iz4jzla8WrRr4='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # Content-hashed bundles: immutable for one year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Images & logos
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML & SEO files
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "^(styles|script)\.[A-Za-z0-9_-]+\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------- Canonical URLs ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{HTTP_HOST} ^qveewellness\.com$ [NC]
  RewriteRule ^ https://www.qveewellness.com%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(about|practices|membership|visit)/?$ /$1.html [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  <Files "booking-config.js">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
</IfModule>

# ---------- Custom error page ----------
ErrorDocument 404 /404.html

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .map
</IfModule>
