# ---------------------------------------------------------------
# QVee Wellness — Apache configuration
# Place this file as .htaccess in the web root.
# Requires: mod_headers, mod_expires, mod_deflate, mod_rewrite, mod_mime
# ---------------------------------------------------------------

# ---------- Security headers ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.google.com https://maps.googleapis.com 'sha256-0Ywux3QOsMnI7wA4ZWesQ0CmDEY8yPbfiQMkypQYFKs=' 'sha256-1GX+8lh/pC8Wuo/12XlbTHziiU8d2yLWR+CPPTR959E=' 'sha256-AHT4xUQvDb+TCXw5flJMgCHn5Cthyl3/B8kNuvgF2wU=' 'sha256-ALATRb3IsOybHuFbonAAmxsoE9G42daaJNZBZ8LMmtY=' 'sha256-DpzyEm8A4InaPqezC3lxAmMEgfwoNkMARNIS04Sv/uU=' 'sha256-EjcG2nvZETeHegmn6xDDxXkjRObOS8/vguYWjRgP9W8=' 'sha256-LhkiEsJZ71GJgDaLyjVpi619Rpdiz++S9jH9YYJ5pLU=' 'sha256-Pjx1+HV8WWiMhQef5H+4ovrmuI03EF3f/BtheqQ6dWM=' 'sha256-RySXf1GoUbQlUl+jqoxJuiKLwYNV26zIRKJnfrxvvys=' 'sha256-ZQdPea27MJO+8x9p10WwwGXSkPeMzSjdAwmPxBGFs/k=' 'sha256-cX3KqOhCaOkif5rOwKsSW0l6Ih9PIK2U2kuX4OegWJw=' 'sha256-rlMscllSWjzsK+MYNIt1Mswahkccc43a4KuUILNSJZ0=' 'sha256-tEdRT4T1FQYnhUIv3BBs2DRBSnyHMSeTvTYcjc2DSXw=' 'sha256-wMRXUL2OnewUkVKTNkMZLIMdrCDnJaEagt1mysFBgEE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'"
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>

# ---------- Caching ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # Content-hashed bundles: immutable for one year
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # Images & logos
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  # HTML & SEO files
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|gif|ico|woff2?)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

# ---------- Clean URLs (extensionless) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect /about.html -> /about
  RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L]

  # Serve /about from /about.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]
</IfModule>

# ---------- Custom error page ----------
ErrorDocument 404 /404.html

# ---------- MIME types ----------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .map
</IfModule>
