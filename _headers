# ---------------------------------------------------------------
# QVee Wellness — caching & security headers
# Supported by Netlify and Cloudflare Pages (place in publish root)
# ---------------------------------------------------------------

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.google.com https://maps.googleapis.com 'sha256-0Ywux3QOsMnI7wA4ZWesQ0CmDEY8yPbfiQMkypQYFKs=' 'sha256-1GX+8lh/pC8Wuo/12XlbTHziiU8d2yLWR+CPPTR959E=' 'sha256-AHT4xUQvDb+TCXw5flJMgCHn5Cthyl3/B8kNuvgF2wU=' 'sha256-ALATRb3IsOybHuFbonAAmxsoE9G42daaJNZBZ8LMmtY=' 'sha256-DpzyEm8A4InaPqezC3lxAmMEgfwoNkMARNIS04Sv/uU=' 'sha256-EjcG2nvZETeHegmn6xDDxXkjRObOS8/vguYWjRgP9W8=' 'sha256-LhkiEsJZ71GJgDaLyjVpi619Rpdiz++S9jH9YYJ5pLU=' 'sha256-Pjx1+HV8WWiMhQef5H+4ovrmuI03EF3f/BtheqQ6dWM=' 'sha256-RySXf1GoUbQlUl+jqoxJuiKLwYNV26zIRKJnfrxvvys=' 'sha256-ZQdPea27MJO+8x9p10WwwGXSkPeMzSjdAwmPxBGFs/k=' 'sha256-cX3KqOhCaOkif5rOwKsSW0l6Ih9PIK2U2kuX4OegWJw=' 'sha256-rlMscllSWjzsK+MYNIt1Mswahkccc43a4KuUILNSJZ0=' 'sha256-tEdRT4T1FQYnhUIv3BBs2DRBSnyHMSeTvTYcjc2DSXw=' 'sha256-wMRXUL2OnewUkVKTNkMZLIMdrCDnJaEagt1mysFBgEE='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# HTML — always revalidate so new deploys are picked up instantly
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Service worker — must never be cached, so updates are detected
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# Content-hashed bundles — safe to cache forever
/assets/built/*
  Cache-Control: public, max-age=31536000, immutable

# Build manifest changes on every deploy — never cache
/assets/built/manifest.json
  Cache-Control: no-cache, must-revalidate

# Images & logos — long cache, background revalidation
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/assets/logo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# SEO files — hourly
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/site.webmanifest
  Cache-Control: public, max-age=3600
