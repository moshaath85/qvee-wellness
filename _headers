# ---------------------------------------------------------------
# QVee Wellness — caching & security headers
# Supported by Netlify and Cloudflare Pages (place in publish root)
# ---------------------------------------------------------------

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.google.com https://maps.googleapis.com 'sha256-5fkgTZ6GqADqP+z57wCtar6DhMcttWvDu6XiYA7eQ0E=' 'sha256-717UnUGB4TDv1E2nvasX8Lvq036wogEh7Ui/3eNLRLg=' 'sha256-I+zBTgAqthFO1BjhhEHs6mlfakC3gxh6cMEh/XM4I3A=' 'sha256-JArooolPSdo64hwg51sspqiZVSVBtaqirppjeNSVMR4=' 'sha256-aHPl/P0tVPk2eA8CnjZFY2RdbNL/fJTf17nbEPLh4fY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://fonts.googleapis.com https://fonts.gstatic.com; frame-src https://www.google.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'self'

# HTML — always revalidate so new deploys are picked up instantly
/*.html
  Cache-Control: no-cache, must-revalidate

/
  Cache-Control: no-cache, must-revalidate

# Service worker — must never be cached, so updates are detected
/sw.js
  Cache-Control: no-cache, must-revalidate
  Service-Worker-Allowed: /

# Content-hashed bundles — safe to cache forever
/assets/built/*
  Cache-Control: public, max-age=31536000, immutable

# Build manifest changes on every deploy — never cache
/assets/built/manifest.json
  Cache-Control: no-cache, must-revalidate

# Images & logos — long cache, background revalidation
/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/assets/logo/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# SEO files — hourly
/robots.txt
  Cache-Control: public, max-age=3600
/sitemap.xml
  Cache-Control: public, max-age=3600
/site.webmanifest
  Cache-Control: public, max-age=3600
